# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave secreta (sb_secret_... o la service_role antigua): SOLO servidor. Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña de la cuenta maestra "admin" (primer acceso y creación de operadores)
ADMIN_PASSWORD=cambia-esto-por-una-clave-larga
# Cadena aleatoria larga para firmar la cookie de sesión (ej: openssl rand -hex 32)
SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios

# El rango de números (ej. 1 a 9999) se configura en la tabla "raffles" de Supabase.

# API de consulta de personas por número de cédula (devuelve datos y foto).
# Usa {doc} donde va el número. Si se deja vacío, la app funciona en MODO DEMO con datos ficticios.
PERSON_API_URL=
# Token de la API (se envía como "Authorization: Bearer <token>"). Solo servidor.
PERSON_API_TOKEN=

# Infopress (SAIME / IPSFA / Resoluciones). Si INFOPRESS_API_KEY tiene valor, se usa en lugar de PERSON_API_URL.
# OJO: solo funciona en una PC conectada a la red donde está 192.168.150.30 (no desde Vercel) y con estas
# líneas en el archivo hosts (Windows: C:\Windows\System32\drivers\etc\hosts):
#   192.168.150.30 infopress.sidefensa.nexus.ia.ve
#   192.168.150.30 s3.infopress.sidefensa.nexus.ia.ve
INFOPRESS_BASE_URL=https://infopress.sidefensa.nexus.ia.ve
INFOPRESS_API_KEY=
